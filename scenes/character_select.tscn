[gd_scene load_steps=2 format=3 uid="uid://bqcharselect001"]

[ext_resource type="Script" path="res://scripts/character_select.gd" id="1_cs"]

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_cs")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.14, 0.18, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "キャラクター選択"

[node name="NameLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "バランス型"

[node name="DescLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "説明"

[node name="PreviewPanel" type="PanelContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2

[node name="PreviewHost" type="Node2D" parent="Margin/VBox/PreviewPanel"]
unique_name_in_owner = true
position = Vector2(120, 90)

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PowerButton" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "パワー型"

[node name="SpeedButton" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "スピード型"

[node name="BalanceButton" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "バランス型"

[node name="Actions" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BackButton" type="Button" parent="Margin/VBox/Actions"]
