text = "このキャラで開始"

[connection signal="pressed" from="Margin/VBox/Buttons/PowerButton" to="." method="_on_power_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/SpeedButton" to="." method="_on_speed_pressed"]
