[gd_scene load_steps=2 format=3 uid="uid://bqsetting001"]

[ext_resource type="Script" path="res://scripts/setting.gd" id="1_setting"]

[node name="Setting" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_setting")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
mouse_filter = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.14, 0.18, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Setting"

[node name="VolumeLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "マスター音量"

[node name="VolumeSlider" type="HSlider" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
max_value = 9.0
value = 7.0
rounded = true

[node name="SizeLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "ブラウザの大きさ"

[node name="SizeOption" type="OptionButton" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="QualityLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "画質（低 / 中 / 大）"

[node name="QualityOption" type="OptionButton" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
size_flags_horizontal = 0
text = "戻る"

[connection signal="value_changed" from="Margin/VBox/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="item_selected" from="Margin/VBox/SizeOption" to="." method="_on_size_selected"]
[connection signal="item_selected" from="Margin/VBox/QualityOption" to="." method="_on_quality_selected"]
[connection signal="pressed" from="Margin/VBox/BackButton" to="." method="_on_back_pressed"]
